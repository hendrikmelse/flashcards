DATABASE_URL=postgres://flashcards:flashcards@localhost:5432/flashcards
PORT=3000

# Who may register: open (default in development), allowlist, or closed.
# Production must set this explicitly or the server refuses to start.
# REGISTRATION_MODE=allowlist
# ALLOWED_EMAILS=you@example.com,friend@example.com

# Email (verification, password reset). Without these, development prints each email to the
# API's console instead of sending it. Production requires all three.
# RESEND_API_KEY=re_...
# MAIL_FROM=Language Flashcards <noreply@mail.example.com>
# Where the app is reached from outside; the links in emails start with it (default: Vite's dev address).
# PUBLIC_URL=http://localhost:5173

# Where to email each report and comment that users send. Optional; without it, reports are only stored.
# REPORT_NOTIFY_EMAIL=you@example.com

# Production only (see Dockerfile and deploy/README.md):
# NODE_ENV=production
# Only behind a trusted reverse proxy (Caddy); makes rate limiting use the real client IP.
# TRUST_PROXY=true
# Directory of the built web app for the API to serve.
# WEB_DIST=/app/web
# MIGRATIONS_DIR=/app/apps/api/drizzle
