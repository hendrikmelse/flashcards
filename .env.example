DATABASE_URL=postgres://flashcards:flashcards@localhost:5432/flashcards
PORT=3000

# Who may register: open (default in development), allowlist, or closed.
# Production must set this explicitly or the server refuses to start.
# REGISTRATION_MODE=allowlist
# ALLOWED_EMAILS=you@example.com,friend@example.com

# Production only (see Dockerfile / deployment notes):
# NODE_ENV=production
# Only behind a trusted reverse proxy (Caddy); makes rate limiting use the real client IP.
# TRUST_PROXY=true
# Directory of the built web app for the API to serve.
# WEB_DIST=/app/web
# MIGRATIONS_DIR=/app/apps/api/drizzle
