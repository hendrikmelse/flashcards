{
  "name": "language-flashcards",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @flashcards/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @flashcards/api",
    "db:migrate": "npm run db:migrate -w @flashcards/api",
    "db:seed": "npm run db:seed -w @flashcards/api",
    "content:check": "npm run content:check -w @flashcards/api",
    "content:import": "npm run content:import -w @flashcards/api",
    "dev:web": "npm run dev -w @flashcards/web",
    "build:web": "npm run build -w @flashcards/web",
    "test": "npm run test --workspaces --if-present",
    "build:api": "npm run build -w @flashcards/api",
    "build": "npm run build:web && npm run build:api"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
