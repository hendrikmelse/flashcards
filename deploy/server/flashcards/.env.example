# Copy to .env on the server and chmod 600 it.
# The host "postgres" is the shared Postgres container on the internal db network.
# Use the password you set when creating the flashcards role (openssl rand -base64 24;
# avoid characters that need URL-encoding, or encode them).
DATABASE_URL=postgres://flashcards:change-me@postgres:5432/flashcards

# Resend API key (resend.com, API Keys, "sending access"). The app refuses to start without it.
RESEND_API_KEY=re_change-me

# Where to email each report and comment that users send (optional; without it, reports are only
# stored, and read in the admin dashboard or with reports.js). Sent from MAIL_FROM through Resend.
REPORT_NOTIFY_EMAIL=you@example.com

# Only used if compose.yaml sets REGISTRATION_MODE to allowlist (it is open): comma-separated
# emails that may create an account. Change it, then run docker compose up -d, to invite someone.
# ALLOWED_EMAILS=you@example.com
