{
  "name": "@flashcards/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "test": "vitest run",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed-cli.ts",
    "reports": "tsx --env-file-if-exists=../../.env src/db/reports-cli.ts",
    "user-role": "tsx --env-file-if-exists=../../.env src/db/user-role-cli.ts",
    "content:check": "tsx src/db/import-content-cli.ts --check",
    "content:import": "tsx --env-file-if-exists=../../.env src/db/import-content-cli.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=../../.env dist/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@flashcards/shared": "^0.0.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "postgres": "^3.4.9",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
